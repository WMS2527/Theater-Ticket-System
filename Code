import numpy as np

#Function for buying one seat at a time.
def buySeat():
    column = int(input("Enter the column number: "))
    row = int(input("Enter the row number: "))
    if row == 1:
        row = 7
    elif row == 2:
        row = 6
    elif row == 3:
        row = 5
    elif row == 4:
        row = 4
    elif row == 5:
        row = 3
    elif row == 6:
        row = 2
    elif row == 7:
        row = 1
    elif row == 8:
        row = 0
    two_d_array[row][column-1] = 00
    printTable(two_d_array)
    
#Function for buying every seat at once.
def soldOut():
    two_d_array.fill(00)
    printTable(two_d_array)

#Function for printing seat array
seatsRemain = True

def printTable(two_d_array):
    for row in two_d_array:
        print(' '.join([f'${cell}' for cell in row]))
data = [10, 10, 10, 10, 10, 10, 10, 10, 10], [10, 10, 10, 10, 10, 10, 10, 10, 10], [10, 10, 10, 10, 10, 10, 10, 10, 10], [10, 10, 10, 10, 10, 10, 10, 10, 10], [10, 20, 20, 20, 20, 20, 20, 20, 10], [20, 30, 30, 30, 30, 30, 30, 30, 20], [30, 40, 40, 40, 40, 40, 40, 40, 30], [30, 40, 40, 50, 50, 50, 40, 40, 30]
two_d_array = np.array(data)
np.set_printoptions(formatter={'all': lambda x: f'${x}'})
print(“Theater Ticket Purchase”)
for row in two_d_array:
    print(' '.join([f'${cell}' for cell in row]))

while (seatsRemain == True):
    #If 1 is inputted, function buySeat is run.
    #If 0 is inputted, function soldOut is run.
    method = int(input("Enter 1 to buy a seat. Enter 0 to sell out all seats."))
    if method == 1:
        buySeat()
    elif method == 0:
        soldOut()
    if (two_d_array==0).all():
        seatsRemain = False

else:
    #Checks if all seats have been purchased. If true, the program stops.
    print("SOLD OUT")
    exit()
